{
  "name": "@helix/server",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "postinstall": "bun run --cwd ../database db:generate"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.41",
    "@ai-sdk/google": "^4.0.51",
    "@ai-sdk/groq": "^4.0.31",
    "@ai-sdk/openai": "^4.0.46",
    "@helix/database": "workspace:*",
    "@helix/shared": "workspace:*",
    "@hono/zod-validator": "^0.9.0",
    "@sentry/bun": "^10.70.0",
    "@sentry/hono": "^10.70.0",
    "ai": "^7.0.79",
    "dotenv": "^17.4.2",
    "hono": "^4.12.33",
    "zod": "^4.4.3"
  }
}
